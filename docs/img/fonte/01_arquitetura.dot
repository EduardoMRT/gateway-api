 subgraph cluster_e { label="Internet / serviços externos"; labelloc=b; style="rounded,filled"; fillcolor="#eaf7ee"; color="#2e8b57";
   x [label="PNCP", fillcolor="#cdeed6", color="#2e8b57"]; y [label="Outras APIs", fillcolor="#cdeed6", color="#2e8b57"]; }
 pkg -> gw [label="  HTTP simples (rede interna)  \n  texto puro na resposta  ", color="#c0392b", penwidth=2.5, fontsize=12];
 gw -> x [label="  HTTPS + JSON  ", color="#2e8b57", penwidth=2.5, fontsize=12]; gw -> y [color="#2e8b57", penwidth=2.5];
}
