 t [shape=none, style="", margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eaf3ff" COLOR="#1f6feb"><TR><TD><B>Texto do gateway</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">123-1|42|A<BR/>123-1|43|B</FONT></TD></TR></TABLE>>];
 s [shape=none, style="", margin=0, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff1f0" COLOR="#c0392b"><TR><TD COLSPAN="3"><B>SELECT ... FROM TABLE(LISTAR(...))</B></TD></TR><TR><TD><B>c1</B></TD><TD><B>c2</B></TD><TD><B>c3</B></TD></TR><TR><TD>123-1</TD><TD>42</TD><TD>A</TD></TR><TR><TD>123-1</TD><TD>43</TD><TD>B</TD></TR></TABLE>>];
 j -> t [label="  gateway: modo=todos  "]; t -> s [label="  PKG_GATEWAY separa\n  linhas e colunas  "];
